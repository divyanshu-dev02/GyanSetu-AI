# Gemini API (server-side only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to force deterministic fixture responses with SSE trace streaming
DEMO_MODE=false

# Optional Upstash / Vercel KV REST credentials (falls back to in-memory store if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
